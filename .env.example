# CiteTax environment settings: an example.
#
# How to use:
#   1. Copy this file to a new file named .env in the same folder (the project root).
#   2. Fill in the values you need. Every setting has a working default, except the API keys.
#   3. Never commit .env. It is listed in .gitignore, so git ignores it; only this example is committed.
#
# Never put real keys in this file. It is public on GitHub.

# ---- Phase D: language model (free tier) ----
# Groq API key, free at https://console.groq.com (API Keys). Needed from Phase D on.
GROQ_API_KEY=
# Optional backup provider for when Groq's daily limit is reached. Free key at https://aistudio.google.com.
GEMINI_API_KEY=

# ---- Phase C: retrieval ----
# Postgres with pgvector, as started by `docker compose up -d db`. Change it only if you run the database elsewhere.
CITETAX_DB_URL=postgresql://citetax:citetax@localhost:5433/citetax
# Embedding model. Changing it means re-running scripts/embed_chunks.py and scripts/load_index.py.
CITETAX_EMBED_MODEL=BAAI/bge-m3

# ---- Phase G: web app ----
# Where the Next.js frontend finds the FastAPI backend. Next.js reads its own env files from frontend/,
# so to change it, put this line in frontend/.env.local rather than here.
CITETAX_API_URL=http://localhost:8000
